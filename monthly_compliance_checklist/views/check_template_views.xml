<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Check Template Form View -->
    <record id="view_check_template_form" model="ir.ui.view">
        <field name="name">check.template.form</field>
        <field name="model">check.template</field>
        <field name="arch" type="xml">
            <form string="Check Template">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="template_type"/>
                        </group>
                        <group>
                            <field name="valid_from"/>
                            <field name="valid_until"/>
                        </group>
                    </group>

                    <notebook>
                         <page string="Configuration">
                             <div invisible="compliance_check_id">
                                 <!-- Legacy template fields for backward compatibility -->
                                 <div invisible="template_type != 'partner_payment'">
                                     <h4>Partner Payment Configuration</h4>
                                     <group>
                                         <group>
                                             <field name="partner_id"/>
                                             <field name="bill_identifier"/>
                                         </group>
                                         <group>
                                             <field name="min_amount"/>
                                             <field name="max_amount"/>
                                             <field name="expected_amount"/>
                                             <field name="amount_tolerance"/>
                                         </group>
                                         <group>
                                             <field name="payment_frequency"/>
                                             <field name="require_reconciliation"/>
                                         </group>
                                     </group>
                                 </div>

                                 <div invisible="template_type != 'attachment_check'">
                                     <h4>Attachment Requirements Configuration</h4>
                                     <group>
                                         <group>
                                             <field name="attachment_types"/>
                                             <field name="min_attachments"/>
                                             <field name="max_attachments"/>
                                         </group>
                                         <group>
                                             <field name="filename_pattern"/>
                                             <field name="min_filesize_kb"/>
                                             <field name="max_filesize_kb"/>
                                         </group>
                                     </group>
                                 </div>

                                 <div invisible="template_type != 'recurring_expense'">
                                     <h4>Recurring Expense Configuration</h4>
                                     <group>
                                         <group>
                                             <field name="expense_category"/>
                                             <field name="expected_range_min"/>
                                             <field name="expected_range_max"/>
                                         </group>
                                         <group>
                                             <field name="variance_alert"/>
                                             <field name="supplier_validation"/>
                                         </group>
                                         <group>
                                             <field name="approved_partners"/>
                                             <field name="account_ids"/>
                                         </group>
                                     </group>
                                 </div>

                                 <div class="alert alert-info" role="alert">
                                     <h4><i class="fa fa-info-circle"/> Setup Required</h4>
                                     <p>Please create a compliance check configuration for this template.</p>
                                     <button name="action_create_compliance_check" string="Create Configuration"
                                             type="object" class="btn-primary"
                                             invisible="template_type == False"/>
                                 </div>
                             </div>

                             <div invisible="compliance_check_id == False">
                                 <group>
                                     <field name="compliance_check_id" readonly="1"/>
                                 </group>

                                 <!-- Human-readable condition summary -->
                                 <div class="alert alert-success mt-3" role="alert">
                                     <h5><i class="fa fa-check-circle"/> Configuration Summary</h5>
                                     <div class="condition-summary">
                                         <field name="condition_summary" nolabel="1" readonly="1" class="text-dark"/>
                                     </div>
                                 </div>

                                 <group>
                                     <button name="action_edit_compliance_check" string="Edit Configuration"
                                             type="object" class="btn-primary"/>
                                 </group>

                                 <!-- Dynamic content area that will be populated by JavaScript -->
                                 <div id="dynamic_check_config" class="mt-3">
                                     <!-- This will be populated dynamically based on compliance_check_id -->
                                 </div>
                             </div>
                         </page>

                        <!-- Help and Examples -->
                        <page string="Help &amp; Examples">
                            <div class="row">
                                <div class="col-md-6">
                                    <h4>Available Check Types</h4>
                                    <div class="list-group">
                                        <div class="list-group-item">
                                            <h5 class="mb-1">Partner Payment Check</h5>
                                            <p class="mb-1">Validates that specific partners have made expected payments.</p>
                                            <small><strong>Example:</strong> Monthly rent payment from landlord</small>
                                        </div>
                                        <div class="list-group-item">
                                            <h5 class="mb-1">Attachment Requirements</h5>
                                            <p class="mb-1">Ensures transactions have required attachments with specific criteria.</p>
                                            <small><strong>Example:</strong> All vendor bills must have PDF invoices attached</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <h4>Configuration Tips</h4>
                                    <ul class="list-unstyled">
                                        <li><i class="fa fa-lightbulb-o text-warning"/> Use validity dates to limit checks to specific time periods</li>
                                        <li><i class="fa fa-lightbulb-o text-warning"/> Test your checks with past data before activating</li>
                                        <li><i class="fa fa-lightbulb-o text-warning"/> Use descriptive names that clearly indicate the requirement</li>
                                        <li><i class="fa fa-lightbulb-o text-warning"/> Consider tolerance levels for amount-based checks</li>
                                    </ul>

                                    <h5 class="mt-4">Need Help?</h5>
                                    <p class="text-muted">
                                        Each check type has specific configuration options that appear after you create the configuration.
                                        Use the "Edit Configuration" button to access the detailed settings.
                                    </p>
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Check Template Tree View -->
    <record id="view_check_template_tree" model="ir.ui.view">
        <field name="name">check.template.tree</field>
        <field name="model">check.template</field>
        <field name="arch" type="xml">
            <tree string="Check Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="template_type"/>
                <field name="valid_from" optional="show"/>
                <field name="valid_until" optional="show"/>
            </tree>
        </field>
    </record>

    <!-- Check Template Action -->
    <record id="action_check_template" model="ir.actions.act_window">
        <field name="name">Check Templates</field>
        <field name="res_model">check.template</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first check template!
            </p>
            <p>
                Check templates define automated compliance conditions.
                Examples: "Water bill 52/2", "Electric bill 349/4", "Bike lease repayments"
            </p>
        </field>
    </record>
</odoo>
