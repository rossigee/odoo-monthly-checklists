<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Backfill Wizard Form View -->
    <record id="view_compliance_backfill_wizard_form" model="ir.ui.view">
        <field name="name">compliance.backfill.wizard.form</field>
        <field name="model">compliance.backfill.wizard</field>
        <field name="arch" type="xml">
            <form string="Backfill Monthly Checklists">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="template_id" options="{'no_create': True, 'no_edit': True}"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Date Range">
                            <label for="start_year" string="Start Date"/>
                            <div class="o_row">
                                <field name="start_year" class="oe_inline" style="width: 80px;"/>
                                <span>/</span>
                                <field name="start_month" class="oe_inline" style="width: 60px;"/>
                            </div>
                            
                            <label for="end_year" string="End Date"/>
                            <div class="o_row">
                                <field name="end_year" class="oe_inline" style="width: 80px;"/>
                                <span>/</span>
                                <field name="end_month" class="oe_inline" style="width: 60px;"/>
                            </div>
                        </group>
                        
                        <group string="Options">
                            <field name="skip_existing"/>
                        </group>
                    </group>
                    
                    <group string="Preview">
                        <field name="months_to_create" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                
                <footer>
                    <button name="action_create_checklists" string="Create Checklists" 
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>