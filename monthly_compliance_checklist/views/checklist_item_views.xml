<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Checklist Item Form View -->
    <record id="view_checklist_item_form" model="ir.ui.view">
        <field name="name">checklist.item.form</field>
        <field name="model">checklist.item</field>
        <field name="arch" type="xml">
            <form string="Checklist Item">
                <header>
                    <button name="debug_search_criteria" string="Debug Search"
                            type="object" class="btn-warning"/>
                    <button name="reevaluate_condition" string="Reevaluate"
                            type="object" class="btn-info"/>
                    <button name="action_mark_complete" string="Mark Complete"
                            type="object" class="btn-primary"
                            invisible="(is_completed == True) or (item_type != 'manual')"/>
                    <button name="action_mark_incomplete" string="Mark Incomplete"
                            type="object" class="btn-secondary"
                            invisible="(is_completed == False) or (item_type != 'manual')"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_transactions" type="object"
                                class="oe_stat_button" icon="fa-list-alt"
                                invisible="transaction_count == 0">
                            <field name="transaction_count" widget="statinfo" string="Transactions"/>
                        </button>
                    </div>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="checklist_id"/>
                            <field name="item_type"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_completed"/>
                            <field name="completion_date"/>
                            <field name="required_transaction_type"
                                   invisible="item_type != 'account'"/>
                        </group>
                    </group>

                    <group>
                        <group>
                            <field name="account_id"
                                   invisible="item_type != 'account'" required="item_type == 'account'"/>
                            <field name="partner_id"
                                   invisible="item_type != 'partner'" required="item_type == 'partner'"/>
                        </group>
                        <group>
                            <field name="notes"/>
                            <field name="debug_info" widget="text"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Related Transactions" invisible="transaction_count == 0">
                            <field name="related_moves" nolabel="1" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="partner_id"/>
                                    <field name="amount_total"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Checklist Item Tree View -->
    <record id="view_checklist_item_tree" model="ir.ui.view">
        <field name="name">checklist.item.tree</field>
        <field name="model">checklist.item</field>
        <field name="arch" type="xml">
            <tree string="Checklist Items" decoration-success="is_completed" decoration-muted="not is_completed">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="checklist_id"/>
                <field name="item_type"/>
                <field name="account_id"/>
                <field name="partner_id"/>
                <field name="transaction_count"/>
                <field name="is_completed"/>
                <field name="completion_date"/>
            </tree>
        </field>
    </record>

    <!-- Checklist Item Action -->
    <record id="action_checklist_item" model="ir.actions.act_window">
        <field name="name">Checklist Items</field>
        <field name="res_model">checklist.item</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
