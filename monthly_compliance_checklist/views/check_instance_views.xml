<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Check Instance Form View -->
    <record id="view_check_instance_form" model="ir.ui.view">
        <field name="name">check.instance.form</field>
        <field name="model">check.instance</field>
        <field name="arch" type="xml">
            <form string="Check Instance">
                <header>
                    <button name="reevaluate_condition" string="Re-evaluate Condition" 
                            type="object" class="btn-primary"/>
                    <field name="is_completed" widget="boolean_button" 
                           options="{'terminology': {'string_true': 'Completed', 'string_false': 'Pending'}}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-external-link" 
                                name="action_view_related_moves" type="object"
                                attrs="{'invisible': [('related_move_ids', '=', [])]}">
                            <field name="related_move_ids" invisible="1"/>
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <t t-esc="len(record.related_move_ids or [])"/>
                                </span>
                                <span class="o_stat_text">Related Moves</span>
                            </div>
                        </button>
                    </div>
                    
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="template_id" readonly="1"/>
                            <field name="checklist_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Validation Details">
                            <group>
                                <field name="validation_message" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                        <page string="Debug Info">
                            <group>
                                <field name="debug_info" widget="text" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                        <page string="Related Transactions" attrs="{'invisible': [('related_move_ids', '=', [])]}">
                            <field name="related_move_ids" nolabel="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="partner_id"/>
                                    <field name="amount_total"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Check Instance Tree View -->
    <record id="view_check_instance_tree" model="ir.ui.view">
        <field name="name">check.instance.tree</field>
        <field name="model">check.instance</field>
        <field name="arch" type="xml">
            <tree string="Check Instances" decoration-success="is_completed" decoration-muted="not is_completed">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="template_id"/>
                <field name="checklist_id"/>
                <field name="is_completed"/>
                <field name="validation_message"/>
                <button name="action_view_related_moves" type="object" 
                        icon="fa-external-link" title="View Related Transactions"
                        attrs="{'invisible': [('related_move_ids', '=', [])]}"/>
                <button name="reevaluate_condition" type="object" 
                        icon="fa-refresh" title="Re-evaluate Condition"/>
                <field name="related_move_ids" invisible="1"/>
            </tree>
        </field>
    </record>
</odoo>